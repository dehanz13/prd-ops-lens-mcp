{
  "name": "prd-ops-lens-mcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "prd-ops-lens-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "evals": "node --import tsx evals/run.ts",
    "guardrails": "node scripts/check-guardrails.mjs",
    "sbom": "npm sbom --package-lock-only --sbom-format cyclonedx",
    "check": "npm run lint && npm run typecheck && npm test && npm run evals && npm run guardrails",
    "secret-scan": "gitleaks git . --no-banner --redact",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
